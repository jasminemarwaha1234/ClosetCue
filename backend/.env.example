# The backend's secret keys. Copy this file to backend/.env and fill it in.
# backend/.env is gitignored; never commit it. The training scripts read it too.
# Nothing loads this file yet: the first feature that needs a key also adds the code that reads it.

# Gemini: photo tagging, try-on images, training data, and the last /outfits fallback.
GEMINI_API_KEY=

# /outfits models on Veri, tried in this order: our trained Llama, then base Llama, then Gemini.
# A model whose URL is empty is skipped. URL: https://api.veri.studio/v1/deployments/<id from
# `veri deployments list`>. NAME: the model name the deployment serves. API_KEY: a Veri key (vk_...).
OUR_LLAMA_URL=
OUR_LLAMA_NAME=
OUR_LLAMA_API_KEY=
BASE_LLAMA_URL=
BASE_LLAMA_NAME=
BASE_LLAMA_API_KEY=

# Supabase: profiles, feedback and mandates. The secret (service_role) key bypasses
# row-level security, so it lives only here, never in the app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe Issuing, sandbox only: the agent's spending-limited cards (PLAN.md section 8).
# The secret key starts with sk_test_. The cardholder ID (ich_...) comes from the
# one cardholder created by hand in the sandbox dashboard.
STRIPE_SECRET_KEY=
STRIPE_CARDHOLDER_ID=

# Sentry DSN for the backend.
SENTRY_DSN=
