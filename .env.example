# The app's settings. Copy this file to .env and fill it in.
# Everything here is built into the app, and anyone with the app can read it.
# Never put a secret key in this file: those go in backend/.env.

# Where the app finds the backend.
# Simulator: http://localhost:8000
# Real phone: your laptop's local network IP, such as http://192.168.1.23:8000,
# or the backend's tunnel URL on Wi-Fi that blocks devices from reaching each other.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL and its publishable (anon) key, for the anonymous sign-in. Not used yet.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_USE_MOCKS=
